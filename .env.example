# Copy this file to .env for local development, or provide these as real
# environment variables in production. Never commit a real .env file.

# --- Database -----------------------------------------------------------
# When running via docker-compose, DATABASE_URL's host must be the service
# name "postgres" (not localhost) and its credentials must match the
# POSTGRES_* values below. When running `next dev` locally against a DB
# exposed on your machine, use localhost instead.
DATABASE_URL=postgres://sales_intel:sales_intel_dev@localhost:5432/sales_intel
POSTGRES_DB=sales_intel
POSTGRES_USER=sales_intel
POSTGRES_PASSWORD=replace-me

# --- Reverse proxy (docker-compose / Caddy) --------------------------------
# Domain Caddy issues a TLS certificate for. Leave as localhost for local dev.
DOMAIN=localhost

# --- Sessions / Auth ------------------------------------------------------
# Generate a fresh random value per deployment, e.g.: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# --- API key encryption at rest -------------------------------------------
# AES-256-GCM key used to encrypt provider API keys stored in the database.
# Generate a fresh value per deployment, e.g.: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# --- Team Chat realtime (WebSocket relay) -----------------------------------
# Port the chat-ws process listens on internally.
CHAT_WS_PORT=4001
# URL the BROWSER connects to.
#   Local dev (`npm run dev` + `npm run chat-ws`, no Caddy):
#     ws://localhost:4001/chat-ws
#   Deployed behind Caddy (see Caddyfile's /chat-ws route):
#     wss://<your-domain>/chat-ws
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:4001/chat-ws

# --- Object storage (MinIO / S3-compatible) --------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sales-intel-uploads
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# --- Initial org seed (first boot only; editable via admin UI afterward) --
INITIAL_ORG_NAME=Sales Intelligence System
INITIAL_ORG_ACCENT_COLOR=#f0975a
INITIAL_ORG_SIDEBAR_COLOR=#5b3fd6
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# --- LLM providers (optional at setup time; can be set later via Admin) ---
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=

# --- Error tracking (optional) ---------------------------------------------
SENTRY_DSN=
